{
  "compilerOptions": {
    /* Language & Environment */
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node","jest"],

    /* Module - plain Node.js, not bundler */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "6.0",
    /* Remove these - they are for bundlers (Vite, esbuild, etc.) */
    // "allowImportingTsExtensions": true,   ← bundler only
    // "verbatimModuleSyntax": true,         ← forces ESM, breaks ts-node
    // "moduleDetection": "force",           ← not needed
    /* Output */
    "outDir": "./dist",
    "rootDir": "./src",

    /* Paths */
   // "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/src/*"],
      "src/*": ["./src/*"]
     
    },

    /* Strictness */
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Useful for Express */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["src", "src/migration/migrate.ts"],
  "exclude": ["node_modules", "dist", "src/migration/**/*"]
}